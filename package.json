{
  "name": "pigeonfs",
  "version": "2.0.0-alpha.1",
  "description": "Files across a PeerPigeon mesh: share, find and fetch them by content, chunk by chunk, from whoever holds them.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "peer": "tsx src/node/peer.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "server": "tsx src/node/server.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "peerpigeon": "github:PeerPigeon/PeerPigeon#7503de6",
    "werift": "0.24.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
